<!-- WinSW-style review template, NOT an installer. Replace every REPLACE value.
     Pin/review the wrapper binary and its schema on Windows before use.
     Run as a dedicated restricted service account configured via Windows SCM.
     Supply DB credentials through protected service configuration, not this XML. -->
<service>
  <id>ClinicApi</id>
  <name>Clinic HTTPS API</name>
  <description>Doctor PC only: FastAPI with prebuilt React assets</description>
  <executable>REPLACE_PYTHON_ABSOLUTE_PATH</executable>
  <workingdirectory>REPLACE_BACKEND_DIRECTORY</workingdirectory>
  <arguments>-m uvicorn app.main:app --host REPLACE_DOCTOR_RESERVED_IP --port 8443 --ssl-certfile "REPLACE_CHAIN_PATH" --ssl-keyfile "REPLACE_KEY_PATH" --no-proxy-headers --no-access-log --no-server-header</arguments>
  <env name="CLINIC_PUBLIC_ORIGIN" value="https://doctor.clinic.home.arpa:8443"/>
  <depend>REPLACE_POSTGRES_WINDOWS_SERVICE_NAME</depend>
  <startmode>Automatic</startmode>
  <onfailure action="restart" delay="10 sec"/>
  <onfailure action="restart" delay="30 sec"/>
  <onfailure action="none"/>
  <stoptimeout>30 sec</stoptimeout>
</service>
