# Inert placeholders only. Use an untracked .env and URL-encode special characters.
CLINIC_DATABASE_URL=postgresql+psycopg://REPLACE_USER:REPLACE_PASSWORD@127.0.0.1:5432/clinic_dev
CLINIC_MIGRATION_DATABASE_URL=postgresql+psycopg://REPLACE_MIGRATOR:REPLACE_PASSWORD@127.0.0.1:5432/clinic_dev
# Local Vite + API development only. Production defaults to HTTPS and requires a trusted HTTPS origin.
CLINIC_ENV=development
CLINIC_PUBLIC_ORIGIN=http://127.0.0.1:5173
POSTGRES_DB=clinic_dev
POSTGRES_USER=REPLACE_MIGRATOR
POSTGRES_PASSWORD=REPLACE_WITH_GENERATED_PASSWORD
# Development scheduling defaults; Python weekdays: Monday=0, Friday=4.
CLINIC_APPOINTMENT_POLICY={"first_visit_minutes":30,"follow_up_minutes":15,"opens":"09:00","closes":"17:00","weekdays":[0,1,2,3,5,6]}
